# PostgreSQL connection strings
# If using Neon: DATABASE_URL = pooled URL (with -pooler in hostname), DIRECT_URL = non-pooled
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://user:password@host-without-pooler/neondb?sslmode=require&channel_binding=require

# Groq API key — get from https://console.groq.com
GROQ_API_KEY=

# LangSmith tracing (optional — service works fine without these)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=onboardflow-ai

# CORS — origin allowed to call this API (ms1 dev server)
ALLOWED_ORIGIN=http://localhost:5173

# HTTP server port
PORT=4000

# SLA in minutes before a pending_approval request is auto-escalated
# Set to 2 for demo purposes; use 60-480 for production
SLA_MINUTES=2
