{
  "name": "ms2-onboardflow-ai",
  "version": "1.0.0",
  "description": "OnboardFlow AI backend — agentic HR workflow service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec 'tsx --require ./sharpMock.cjs --require ./fetchPolyfill.cjs src/server.ts'",
    "build": "tsc",
    "start": "node --require ./sharpMock.cjs --require ./fetchPolyfill.cjs dist/server.js",
    "ingest": "tsx --require ./sharpMock.cjs --require ./fetchPolyfill.cjs src/rag/ingest.ts",
    "migrate": "prisma migrate deploy && tsx prisma/applyVectorMigration.ts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "optionalDependencies": {
    "sharp": "*"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/groq": "^0.1.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.5",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
